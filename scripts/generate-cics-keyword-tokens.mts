import { readFile, writeFile } from "fs/promises";
import { dirname, resolve } from "path";
import { fileURLToPath } from "url";

const __dirname = dirname(fileURLToPath(import.meta.url));
const licenseHeader = await readFile("./license-header.js", "utf8");

const blacklist = new Set(["CICS", "EXEC"]);

type CicsKeywordFile = {
  control: string[];
  storage: string[];
};

const cicsKeywords = JSON.parse(
  await readFile(resolve(__dirname, "cics-keywords.json"), "utf8"),
) as CicsKeywordFile;

const control = new Set(cicsKeywords.control);

let sourceCode = `${licenseHeader}
// THIS FILE WAS GENERATED BY scripts/generate-cics-keyword-tokens.mts
// DO NOT EDIT THIS FILE DIRECTLY. INSTEAD, EDIT THE GENERATOR AND RE-GENERATE THE FILE.

import { createKeywordRegistry, KeywordType } from "./shared";

const { registerKeyword, keywordMap, keywords } = createKeywordRegistry();
export { keywordMap, keywords };

`;

for (const element of cicsKeywords.control
  .concat(cicsKeywords.storage)
  .sort()) {
  const keyword = element.toUpperCase();
  if (blacklist.has(keyword)) {
    continue;
  }
  sourceCode += `export const ${keyword} = registerKeyword({
  name: "${keyword}",${control.has(element) ? "\n  type: KeywordType.Control," : ""}
});
`;
}

await writeFile(
  "./packages/language/src/parser/tokens/cics-tokens.generated.ts",
  sourceCode,
);
