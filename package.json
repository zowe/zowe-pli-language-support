{
  "name": "pli-workspace",
  "description": "Base workspace package",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "pnpm --dir packages/language clean && pnpm --dir packages/preprocessor-cics clean && pnpm --dir packages/preprocessor-db2 clean && pnpm --dir packages/vscode-extension clean",
    "tsc": "tsc -b tsconfig.build.json",
    "generate": "pnpm --dir packages/preprocessor-cics grammar && pnpm --dir packages/preprocessor-db2 grammar",
    "compile": "pnpm tsc",
    "bundle": "pnpm --dir packages/vscode-extension esbuild:bundle",
    "merge": "tsx ./scripts/generate-tmlanguage.mts",
    "build:full": "pnpm clean && pnpm generate && pnpm build",
    "build": "pnpm compile && pnpm bundle && pnpm merge",
    "package": "pnpm build:full && pnpm --dir packages/vscode-extension package",
    "test": "vitest",
    "test:fourslash": "vitest run packages/language/test/fourslash-harness/execute.test.ts",
    "coverage": "vitest run --coverage",
    "lint": "prettier -c \"**/*.{ts,mts}\"",
    "pretty": "prettier -w \"**/*.{ts,mts}\"",
    "playground": "pnpm --dir packages/playground build",
    "playground:clean": "pnpm --dir packages/playground clean",
    "watch": "tsc -b tsconfig.build.json --watch",
    "license:check": "tsx ./scripts/check-license-headers.mts",
    "license:fix": "tsx ./scripts/check-license-headers.mts --fix",
    "extract-compiler-tests": "tsx ./scripts/extract-compiler-tests.mts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "glob": "^13.0.6",
    "prettier": "^3.9.6",
    "shx": "~0.4.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.8.0"
}
