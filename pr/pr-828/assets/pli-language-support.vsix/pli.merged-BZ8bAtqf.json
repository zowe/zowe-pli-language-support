{
  "name": "pli",
  "scopeName": "source.pli",
  "fileTypes": [
    ".pli"
  ],
  "patterns": [
    {
      "name": "keyword.storage.pli",
      "match": "(?i)\\b(any|arithmetic|number|unknown|subscriptrange|nochargraphic|nonassignable|nonasgn|fixedoverflow|fofl|undefinedfile|undf|valuelistfrom|nodescriptor|nonconnected|littleendian|anycondition|anycond|chargraphic|irreducible|irred|dllinternal|unreachable|environment|env|bufnd|bufni|bufsp|blksize|buffers|recsize|keyloc|password|regional|organization|bkwd|total|genkey|reuse|vsam|scalarvarying|reread|ctlasa|ctl360|consecutive|indexed|relative|descriptors|conformance|stringrange|descriptor|xmlcontent|jsonignore|assignable|controlled|ctl|nonvarying|nonvar|sequential|seql|conversion|stringsize|zerodivide|zdiv|initacross|valuerange|xmlignore|jsontrimr|noexecops|deactivate|deact|reducible|red|reentrant|fetchable|fromalien|assembler|asm|recursive|procedure|proc|xprocedure|xproc|statement|stmt|character|char|dimacross|automatic|auto|backwards|condition|cond|connected|exclusive|nonnative|parameter|precision|prec|structure|struct|transient|unaligned|unal|bigendian|assertion|attention|invalidop|underflow|ufl|dimension|dim|valuelist|reserves|jsonname|jsonnull|jsonomit|nomapout|noinline|noreturn|external|ext|variable|allocate|alloc|widechar|wchar|abnormal|buffered|buf|unbuffered|unbuf|constant|internal|optional|position|pos|reserved|imported|unsigned|varying4|varyingz|varz|downthru|replace|noprint|overflow|ofl|transmit|linesize|pagesize|nullinit|procinc|xmlname|xmlattr|xmlomit|resignal|package|exports|options|linkage|optlink|stdcall|nomapin|fortran|byvalue|amode31|amode64|retcode|winmain|dynamic|limited|graphic|compare|default|dft|aligned|builtin|complex|decimal|dec|generic|hexadec|outonly|pointer|ptr|varying|var|ordinal|display|routcde|iterate|activate|act|norescan|keyfrom|storage|endfile|endpage|qualify|release|rewrite|initial|init|declare|dcl|xdeclare|xdcl|picture|pic|widepic|returns|system|inline|byaddr|static|assert|attach|answer|ans|margins|mar|thread|tstack|cancel|binary|bin|varbinary|format|noinit|inonly|indfor|member|native|normal|offset|output|record|signed|stream|update|define|xdefine|defined|def|delete|detach|upthru|repeat|column|col|string|noscan|rescan|locate|finish|direct|ignore|reinit|signal|handle|cdecl|cmpat|nomap|order|reorder|cobol|inter|entry|uchar|false|close|range|based|event|fixed|float|inout|input|keyed|label|print|union|alias|value|delay|reply|until|fetch|title|flush|leave|error|push|keyto|revert|write|refer|note|main|rent|area|true|text|name|call|file|ieee|list|real|task|desc|exit|line|page|skip|scan|free|copy|snap|size|open|pop|data|with|edit|read|into|from|loop|forever|stop|wait|date|type|like|set|bit|and|not|int|key|get|put|v1|v2|v3|in|by|or|fb|ufs|fbs|vb|vs|vbs|a|b|c|f|e|g|k|m|p|l|r|u|v|x|is|xml|as|large|object|blob|clob|dbclob|blob_locator|clob_locator|dbclob_locator|blob_file|clob_file|dbclob_file|rowid|table|locator|result_set_locator|dfhresp|notfnd|duprec|invreq|nospace|notopen|lengerr|qzero|qbusy|itemerr|pgmiderr|enddata|mapfail|qiderr|enqbusy|disabled)\\b"
    },
    {
      "name": "keyword.control.pli",
      "match": "(?i)\\b(otherwise|other|include|xinclude|inscan|xinscan|process|return|select|begin|while|goto|then|else|when|end|do|to|go|if|on)\\b"
    },
    {
      "name": "string.quoted.sql.pli",
      "match": "(?i:EXEC\\s+SQL)"
    },
    {
      "name": "string.quoted.cics.pli",
      "match": "(?i:EXEC\\s+CICS)"
    },
    {
      "name": "string.quoted.single.pli",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "string.double.single.pli",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "constant.numeric.decimal.pli",
      "match": "([0-9][0-9_]*(\\.[0-9_]+)?)|(\\.[0-9_]+)([ESDQ][-+]?[0-9]+)?([bB]|[iI])*"
    },
    {
      "name": "entity.other.pli",
      "match": "[a-zA-Z_][a-zA-Z0-9_]*"
    }
  ],
  "repository": {
    "string-character-escape": {
      "name": "constant.character.escape.pli",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}