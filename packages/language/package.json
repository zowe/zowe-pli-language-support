{
  "name": "pli-language",
  "description": "The language specific package",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "out",
    "src"
  ],
  "main": "./out/index.js",
  "module": "./out/index.js",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./builtins": {
      "types": "./out/workspace/builtins.d.ts",
      "default": "./out/workspace/builtins.js"
    },
    "./playground-link": {
      "types": "./out/workspace/playground-link.d.ts",
      "default": "./out/workspace/playground-link.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "out/index"
      ],
      "./builtins": [
        "out/workspace/builtins"
      ],
      "./playground-link": [
        "out/workspace/playground-link"
      ]
    }
  },
  "scripts": {
    "clean": "shx rm -fr *.tsbuildinfo out"
  },
  "dependencies": {
    "@chevrotain/regexp-to-ast": "^12.0.0",
    "@chevrotain/types": "^12.0.0",
    "@chevrotain/utils": "^12.0.0",
    "chevrotain": "^12.0.0",
    "jsonc-parser": "4.0.0-next.1",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.5.2",
    "lz-string": "^1.5.0",
    "minimatch": "10.2.4",
    "preprocessor-api": "workspace:*",
    "preprocessor-cics": "workspace:*",
    "preprocessor-db2": "workspace:*",
    "vscode-languageserver": "10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "3.18.0",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12"
  }
}
