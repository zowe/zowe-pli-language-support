{
  "name": "pli-playground",
  "description": "PL/I language playground",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "shx rm -fr *.tsbuildinfo out",
    "copy:extensions": "shx cp ../vscode-extension/pli-language-support.vsix ./pli-language-support.vsix",
    "build": "pnpm copy:extensions && vite -c vite.config.ts build",
    "serve": "vite -c vite.config.ts serve",
    "preview": "vite -c vite.config.ts preview",
    "build:clean": "pnpm clean && pnpm build",
    "dev": "vite -c vite.config.ts",
    "dev:debug": "vite -c vite.config.ts --debug --force"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "^25.1.2",
    "@codingame/monaco-vscode-explorer-service-override": "^25.1.2",
    "@codingame/monaco-vscode-files-service-override": "^25.1.2",
    "@codingame/monaco-vscode-keybindings-service-override": "^25.1.2",
    "@codingame/monaco-vscode-markers-service-override": "^25.1.2",
    "@codingame/monaco-vscode-outline-service-override": "^25.1.2",
    "@codingame/monaco-vscode-views-service-override": "^25.1.2",
    "lz-string": "^1.5.0",
    "monaco-languageclient": "~10.7.0",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@^25.1.2",
    "vscode-json-languageservice": "~5.4.4"
  },
  "devDependencies": {
    "@codingame/monaco-vscode-rollup-vsix-plugin": "^25.1.2",
    "vite": "^8.0.16"
  }
}
