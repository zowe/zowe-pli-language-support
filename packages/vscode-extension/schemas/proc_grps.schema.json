{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PL/I Plugin Procedure Groups Configuration",
  "type": "object",
  "properties": {
    "pgroups": {
      "type": "array",
      "description": "List of procedure groups with build configuration.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the procedure group (e.g., 'default')."
          },
          "compiler-options": {
            "type": "array",
            "description": "Compiler options for this group.",
            "items": {
              "type": "string"
            }
          },
          "libs": {
            "type": "array",
            "description": "List of libraries to include during compilation.",
            "items": {
              "type": "string"
            }
          },
          "pli-options": {
            "type": "object",
            "description": "Macro definitions which will be passed to the PL/I compiler."
          },
          "include-extensions": {
            "type": "array",
            "description": "List of file extensions to treat as include files.",
            "items": {
              "type": "string",
              "enum": [".pli", ".pl1", ".cpy", ".inc"]
            }
          },
          "implicit-builtins": {
            "type": "array",
            "description": "List of builtins to include implicitly.",
            "items": {
              "type": "string"
            }
          },
          "lsp-options": {
            "type": "object",
            "description": "Options for the Language Server Protocol.",
            "properties": {
              "check-margins": {
                "type": "boolean",
                "description": "Whether to check for margins in the PL/I code."
              }
            }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["pgroups"],
  "additionalProperties": false
}
  